{
  /* Curation scripts under scripts/. They import src/content directly and run
     under vitest, so they use bundler resolution like the app rather than the
     nodenext resolution of tsconfig.node.json. Typechecked by `tsc -b` so a
     rename in src/content cannot silently stop the citation checker from
     finding citations. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    /* vite/client alongside node: these scripts run under vitest, which is
       Vite, and they import src/content, which uses import.meta.glob to
       lazy-load the reading corpus. */
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts", "vitest.config.ts"]
}
